{
  "name": "agent-foundry",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:core": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "node --test --test-timeout=20000 --import tsx tests/**/*.test.ts",
    "api": "node --env-file=.env --import tsx services/http/src/app.ts",
    "mcp": "node --env-file=.env --import tsx services/mcp/src/server.ts",
    "mcp:http": "node --env-file=.env --import tsx services/mcp/src/http.ts",
    "dashboard": "npm --workspace @agentic-factory/dashboard run dev",
    "dashboard:build": "npm --workspace @agentic-factory/dashboard run build",
    "demo": "npm run build:core && node --env-file=.env dist/services/orchestrator/src/demo.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/express": "^5.0.6",
    "eslint": "^9.18.0",
    "express": "^5.2.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.20.0",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "p-queue": "^9.3.0"
  }
}
